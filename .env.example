# LaborFlow local/deployment environment template.
# Copy this file to .env for local development. Do not commit real secrets.

WEB_PORT=5580
CORE_PORT=5581
FAST_PORT=5582
DB_PORT=55432
REDIS_PORT=56379
WEB_HOST=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_DOMAIN=localhost
ACME_EMAIL=admin@example.com

POSTGRES_DB=laborflow_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

SERVER_PORT=5581
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:55432/laborflow_db
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=56379
SPRING_DATA_REDIS_PASSWORD=change-me
SPRING_CACHE_REDIS_TTL=300s

LABORFLOW_FAST_BIND_ADDR=127.0.0.1:5582

VITE_API_BASE_URL=http://localhost:5581
VITE_FAST_API_BASE_URL=http://localhost:5582
VITE_REALTIME_WS_URL=ws://localhost:5582/ws
